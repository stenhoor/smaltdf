{
  "name": "@smaltworks/smaltdf",
  "version": "0.1.0",
  "description": "A TypeScript language for smaltdb with dataframe interfaces, built on smaltdb's engine plan layer",
  "keywords": [
    "smaltdb",
    "dataframe",
    "typescript",
    "dsl"
  ],
  "author": "stenhoor",
  "license": "MIT",
  "homepage": "https://github.com/stenhoor/smaltdf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltdf.git"
  },
  "bugs": {
    "url": "https://github.com/stenhoor/smaltdf/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "deps": "node scripts/fetch-packed.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/fetch-packed.mjs --check && tsc -p tsconfig.json",
    "test": "node scripts/fetch-packed.mjs --check && vitest run",
    "check": "npm run typecheck && npm test",
    "compare": "node scripts/fetch-packed.mjs --check && vitest run --config vitest.compare.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run check && npm run build"
  },
  "peerDependencies": {
    "smaltdb": ">=0.9.0 <0.10.0"
  },
  "peerDependenciesMeta": {
    "smaltdb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "smaltkit": "github:stenhoor/smaltkit#3a6f12837e490cbc005b1255782ecf7d6fe50813",
    "typescript": "5.9",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  }
}
